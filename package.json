{
  "name": "bzh-tracker",
  "version": "1.3.2",
  "description": "BreizhAir Flight Tracker — Client ACARS",
  "main": "src/main/index.js",
  "author": "Aurélien POULICHET",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:icon": "electron-icon-builder --input=assets/icon.png --output=assets",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.3",
    "socket.io-client": "^4.7.5"
  },
  "optionalDependencies": {
    "node-simconnect": "^4.1.0-beta.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-icon-builder": "^2.0.1"
  },
  "build": {
    "appId": "fr.breizhair.tracker",
    "productName": "BZH Tracker",
    "protocols": [
      {
        "name": "BZH Tracker",
        "schemes": [
          "bzh-tracker"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/win/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/mac/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/png/512x512.png",
      "category": "Utility"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!node_modules/**/{CHANGELOG.md,README.md,readme.md,test,tests,__tests__}",
      "!node_modules/.bin"
    ],
    "asarUnpack": [
      "node_modules/node-simconnect/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "FeTouk",
      "repo": "bzh-tracker",
      "releaseType": "release"
    }
  }
}
